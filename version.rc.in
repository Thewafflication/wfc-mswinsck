#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @WFC_LIB_VERSION_MAJOR@,@WFC_LIB_VERSION_MINOR@,@WFC_LIB_VERSION_PATCH@,0
PRODUCTVERSION @WFC_LIB_VERSION_MAJOR@,@WFC_LIB_VERSION_MINOR@,@WFC_LIB_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "Comments", "Targets @WFC_LIB_TARGET@"
            VALUE "CompanyName", "Waughtal"
            VALUE "FileDescription", "@WFC_LIB_DESCRIPTION@"
            VALUE "FileVersion", "@WFC_LIB_VERSION@"
            VALUE "InternalName", "@WFC_LIB_NAME@"
            VALUE "OriginalFilename", "@WFC_LIB_NAME@.dll"
            VALUE "ProductName", "WFC"
            VALUE "ProductVersion", "@WFC_LIB_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
